<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfilePic"
            android:layout_width="100dp" android:layout_height="100dp"
            app:cardCornerRadius="50dp" app:cardElevation="0dp"
            app:cardBackgroundColor="#1A4CAF50"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imgEditAvatar"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_run"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTapHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tap photo to change"
            android:textColor="#4CAF50" android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/cardProfilePic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/lblName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="YOUR NAME" android:textColor="#4CAF50"
            android:textSize="11sp" android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/tvTapHint"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp" android:layout_height="56dp"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#444444"
            android:background="@drawable/bg_card"
            android:paddingStart="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lblName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/lblAge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AGE" android:textColor="#4CAF50"
            android:textSize="11sp" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/etName"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/tvAgeValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="25" android:textColor="#4CAF50" android:textSize="32sp"
            app:layout_constraintTop_toBottomOf="@id/lblAge"
            app:layout_constraintEnd_toEndOf="parent"/>
        <SeekBar android:id="@+id/seekAge"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:min="10" android:max="100" android:progress="25"
            app:layout_constraintTop_toBottomOf="@id/tvAgeValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/lblHeight"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="HEIGHT" android:textColor="#4CAF50"
            android:textSize="11sp" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/seekAge"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/tvHeightValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="175 cm" android:textColor="#4CAF50" android:textSize="32sp"
            app:layout_constraintTop_toBottomOf="@id/lblHeight"
            app:layout_constraintEnd_toEndOf="parent"/>
        <SeekBar android:id="@+id/seekHeight"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:min="100" android:max="250" android:progress="175"
            app:layout_constraintTop_toBottomOf="@id/tvHeightValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/lblWeight"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="WEIGHT" android:textColor="#4CAF50"
            android:textSize="11sp" android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/seekHeight"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView android:id="@+id/tvWeightValue"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="70 kg" android:textColor="#4CAF50" android:textSize="32sp"
            app:layout_constraintTop_toBottomOf="@id/lblWeight"
            app:layout_constraintEnd_toEndOf="parent"/>
        <SeekBar android:id="@+id/seekWeight"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:min="30" android:max="200" android:progress="70"
            app:layout_constraintTop_toBottomOf="@id/tvWeightValue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/lblGender"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GENDER" android:textColor="#4CAF50"
            android:textSize="11sp" android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/seekWeight"
            app:layout_constraintStart_toStartOf="parent"/>
        <RadioGroup android:id="@+id/rgGender"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/lblGender"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <RadioButton android:id="@+id/rbMale" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Male" android:textColor="#FFFFFF" android:buttonTint="#4CAF50" android:checked="true"/>
            <RadioButton android:id="@+id/rbFemale" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Female" android:textColor="#FFFFFF" android:buttonTint="#4CAF50"/>
            <RadioButton android:id="@+id/rbOther" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Other" android:textColor="#FFFFFF" android:buttonTint="#4CAF50"/>
        </RadioGroup>

        <!-- BMI Display -->
        <LinearLayout
            android:id="@+id/layoutBMI"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/rgGender"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YOUR BMI" android:textColor="#888888" android:textSize="12sp"/>

            <TextView android:id="@+id/tvBMI"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textColor="#4CAF50"
                android:textSize="36sp" android:fontFamily="sans-serif-bold"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- CTA Button -->
        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="0dp" android:layout_height="56dp"
            android:text="SAVE PROFILE"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_green"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/layoutBMI"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>