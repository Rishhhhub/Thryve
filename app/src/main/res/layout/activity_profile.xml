<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0A"
    android:padding="24dp">

    <ImageView android:id="@+id/btnBackProfile"
        android:layout_width="40dp" android:layout_height="40dp"
        android:src="@drawable/ic_back" android:padding="8dp"
        android:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="EDIT PROFILE" android:textColor="#FFFFFF"
        android:textSize="18sp" android:fontFamily="sans-serif-bold"
        app:layout_constraintTop_toTopOf="@id/btnBackProfile"
        app:layout_constraintBottom_toBottomOf="@id/btnBackProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView android:id="@+id/lbl_name"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="YOUR NAME" android:textColor="#4CAF50"
        android:textSize="12sp" android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnBackProfile"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText android:id="@+id/etName"
        android:layout_width="0dp" android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="16dp" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView android:id="@+id/lbl_age"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AGE" android:textColor="#4CAF50"
        android:textSize="12sp" android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etName"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText android:id="@+id/etAge"
        android:layout_width="0dp" android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="16dp" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/lbl_age"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView android:id="@+id/lbl_height"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HEIGHT (CM)" android:textColor="#4CAF50"
        android:textSize="12sp" android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etAge"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText android:id="@+id/etHeight"
        android:layout_width="0dp" android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="16dp" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/lbl_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView android:id="@+id/lbl_weight"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="WEIGHT (KG)" android:textColor="#4CAF50"
        android:textSize="12sp" android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/etHeight"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText android:id="@+id/etWeight"
        android:layout_width="0dp" android:layout_height="56dp"
        android:background="@drawable/bg_search_bar"
        android:paddingStart="16dp" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/lbl_weight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutBMI"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:background="#111811"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/etWeight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="YOUR BMI" android:textColor="#888888" android:textSize="12sp"/>

        <TextView android:id="@+id/tvBMI"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--" android:textColor="#4CAF50"
            android:textSize="36sp" android:fontFamily="sans-serif-bold"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <Button android:id="@+id/btnSaveProfile"
        android:layout_width="0dp" android:layout_height="56dp"
        android:text="SAVE CHANGES" android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>