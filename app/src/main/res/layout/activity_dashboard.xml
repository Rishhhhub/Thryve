<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout android:id="@+id/layoutTopBar"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.cardview.widget.CardView
                    android:layout_width="44dp" android:layout_height="44dp"
                    app:cardCornerRadius="22dp" app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A4CAF50">
                    <ImageView android:id="@+id/imgAvatar"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:src="@drawable/ic_run"
                        android:scaleType="centerCrop"/>
                </androidx.cardview.widget.CardView>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GOOD MORNING" android:textColor="#4CAF50"
                        android:textSize="10sp" android:letterSpacing="0.12"/>
                    <TextView android:id="@+id/tvUsername"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Athlete" android:textColor="#FFFFFF"
                        android:textSize="18sp" android:fontFamily="sans-serif-bold"/>
                </LinearLayout>

                <ImageView android:id="@+id/imgNotification"
                    android:layout_width="36dp" android:layout_height="36dp"
                    android:src="@drawable/ic_bell" android:padding="6dp" app:tint="#AAAAAA"/>
            </LinearLayout>

            <RelativeLayout android:id="@+id/layoutReadinessRing"
                android:layout_width="200dp" android:layout_height="200dp"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <com.example.thryve.ui.TripleRingView android:id="@+id/tripleRingView"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center"
                    android:layout_centerInParent="true">
                    <TextView android:id="@+id/tvReadinessScore"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="84" android:textColor="#FFFFFF"
                        android:textSize="40sp" android:fontFamily="sans-serif-bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="READINESS" android:textColor="#888888" android:textSize="10sp"/>
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout android:id="@+id/layoutStatsRow"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="20dp"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/layoutReadinessRing"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout android:id="@+id/layoutRecovery"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="8dp" android:layout_height="8dp"
                            android:background="@drawable/bg_dot_green"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RECOVERY" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvRecovery"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="85%" android:textColor="#FFFFFF"
                        android:textSize="20sp" android:fontFamily="sans-serif-bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="40dp"
                    android:background="#2A2A2A" android:layout_gravity="center_vertical"/>

                <LinearLayout android:id="@+id/layoutStrain"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="8dp" android:layout_height="8dp"
                            android:background="@drawable/bg_dot_orange"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="STRAIN" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvStrain"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="14.5" android:textColor="#FFFFFF"
                        android:textSize="20sp" android:fontFamily="sans-serif-bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="40dp"
                    android:background="#2A2A2A" android:layout_gravity="center_vertical"/>

                <LinearLayout android:id="@+id/layoutSleep"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <View android:layout_width="8dp" android:layout_height="8dp"
                            android:background="@drawable/bg_dot_blue"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SLEEP" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvSleep"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="7h 48m" android:textColor="#FFFFFF"
                        android:textSize="20sp" android:fontFamily="sans-serif-bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView android:id="@+id/cardHeartRate"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/layoutStatsRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="LIVE HEART RATE"
                            android:textColor="#888888" android:textSize="11sp"/>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_heart" app:tint="#E53935"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="bottom"
                        android:layout_marginTop="4dp">
                        <TextView android:id="@+id/tvHeartRate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="72" android:textColor="#FF5252"
                            android:textSize="36sp" android:fontFamily="sans-serif-bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" BPM" android:textColor="#888888"
                            android:textSize="14sp" android:layout_marginBottom="6dp"/>
                    </LinearLayout>
                    <com.example.thryve.ui.HeartRateBarView
                        android:id="@+id/heartRateBarView"
                        android:layout_width="match_parent" android:layout_height="60dp"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:id="@+id/layoutQuickActions"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardHeartRate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSteps"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#111811" app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_run" app:tint="#4CAF50"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="STEPS" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginTop="6dp"/>
                        <TextView android:id="@+id/tvSteps"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="8,432" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="of 10,000" android:textColor="#4CAF50" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSleepSummary"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#111811" app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_sleep" app:tint="#2196F3"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SLEEP" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginTop="6dp"/>
                        <TextView android:id="@+id/tvSleepCard"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="7h 48m" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Good quality" android:textColor="#2196F3" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <Button android:id="@+id/btnStartRun"
                android:layout_width="0dp" android:layout_height="56dp"
                android:text="▶  START RUN"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:background="@drawable/bg_btn_green"
                android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/layoutQuickActions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/bottomNav"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:background="#0D120D"
        android:gravity="center_vertical" android:paddingBottom="4dp"
        android:layout_gravity="bottom">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" app:tint="#4CAF50"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME" android:textColor="#4CAF50" android:textSize="9sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navJournal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_journal" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JOURNAL" android:textColor="#666666" android:textSize="9sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/navTrain" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_train" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TRAIN" android:textColor="#666666" android:textSize="9sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navDevice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_device" app:tint="#666666"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEVICE" android:textColor="#666666" android:textSize="9sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:src="@drawable/ic_add"
        app:backgroundTint="#4CAF50" app:tint="#FFFFFF"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>