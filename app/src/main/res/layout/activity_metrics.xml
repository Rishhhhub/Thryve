<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E0E"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STEP 1\nPhysical Metrics"
        android:textColor="#00FF7F"
        android:textStyle="bold" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="33"
        android:progressTint="#00FF7F"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tell us about yourself"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GENDER IDENTITY"
        android:textColor="#8A8A8A"
        android:layout_marginTop="24dp"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/genderSpinner"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/spinner_bg"
        android:padding="10dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEIGHT"
            android:textColor="#8A8A8A" />
        <TextView
            android:id="@+id/heightDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="178 cm"
            android:textColor="#00FF7F"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/heightSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:valueFrom="100"
        android:valueTo="250"
        android:value="178"
        app:thumbColor="#00FF7F"
        app:trackColorActive="#00FF7F" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WEIGHT"
        android:textColor="#8A8A8A"
        android:layout_marginTop="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@drawable/spinner_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/btnMinus"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:text="—"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/weightValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="72.5 kg"
            android:textColor="#00FF7F"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btnPlus"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:text="+"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="24sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#00FF7F"
        android:text="Continue —>"
        android:textColor="#000000"
        android:textAllCaps="false" />

</LinearLayout>