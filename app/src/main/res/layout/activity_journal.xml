<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0A">

    <LinearLayout android:id="@+id/layoutTopBar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="20dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/btnBack"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_back" android:tint="#FFFFFF" android:padding="6dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Daily Journal"
            android:textColor="#FFFFFF" android:textSize="18sp"
            android:fontFamily="sans-serif-bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Today's Habits" android:textColor="#FFFFFF"
                android:textSize="22sp" android:fontFamily="sans-serif-bold"
                android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Track your daily wellness habits"
                android:textColor="#888888" android:textSize="13sp"
                android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

            <!-- Habit switches — one card per habit -->
            <!-- HYDRATION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_bolt" android:tint="#2196F3"
                        android:background="@drawable/bg_circle_dark_blue" android:padding="6dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Hydration" android:textColor="#FFFFFF" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Drank 8 glasses of water" android:textColor="#888888"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHydration"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#4CAF50" app:trackTint="#1A4CAF50"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- STRETCHING -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_train" android:tint="#FF9800"
                        android:background="@drawable/bg_circle_dark_orange" android:padding="6dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Morning Stretch" android:textColor="#FFFFFF" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="10 min stretching routine" android:textColor="#888888"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchStretch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="#4CAF50" app:trackTint="#1A4CAF50"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- MEDITATION -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_heart" android:tint="#4CAF50"
                        android:background="@drawable/bg_circle_dark_green" android:padding="6dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Meditation" android:textColor="#FFFFFF" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="5 min mindfulness session" android:textColor="#888888"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMeditation"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#4CAF50" app:trackTint="#1A4CAF50"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- HEALTHY MEALS -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_flame" android:tint="#E53935"
                        android:background="@drawable/bg_circle_dark_red" android:padding="6dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Healthy Meals" android:textColor="#FFFFFF" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Ate nutritious food today" android:textColor="#888888"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMeals"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="#4CAF50" app:trackTint="#1A4CAF50"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SLEEP ON TIME -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#111811" app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_sleep" android:tint="#7C4DFF"
                        android:background="@drawable/bg_circle_dark_purple" android:padding="6dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Sleep on Time" android:textColor="#FFFFFF" android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Slept before 11 PM" android:textColor="#888888"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSleep"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#4CAF50" app:trackTint="#1A4CAF50"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NOTE FIELD -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NOTES" android:textColor="#4CAF50"
                android:textSize="11sp" android:letterSpacing="0.1"
                android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>

            <EditText android:id="@+id/etNote"
                android:layout_width="match_parent" android:layout_height="100dp"
                android:hint="How are you feeling today?"
                android:inputType="textMultiLine" android:gravity="top"
                android:textColor="#FFFFFF" android:textColorHint="#444444"
                android:background="@drawable/bg_card"
                android:padding="12dp"/>

            <Button android:id="@+id/btnSaveJournal"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="SAVE JOURNAL"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:background="@drawable/bg_btn_green"
                android:layout_marginTop="20dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>