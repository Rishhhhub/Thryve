<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F0A">

    <!-- TOP BAR (same pattern as all detail screens) -->
    <LinearLayout android:id="@+id/layoutTopBar"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="20dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView android:id="@+id/btnBack"
            android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_back" app:tint="#FFFFFF" android:padding="6dp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Steps"
            android:textColor="#FFFFFF" android:textSize="18sp"
            android:fontFamily="sans-serif-bold" android:gravity="center"/>
        <View android:layout_width="36dp" android:layout_height="36dp"/>
    </LinearLayout>

    <ScrollView android:layout_width="0dp" android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingBottom="32dp" android:gravity="center_horizontal">

            <!-- Steps count ring -->
            <RelativeLayout android:layout_width="200dp" android:layout_height="200dp"
                android:layout_marginTop="24dp">
                <com.example.thryve.ui.RecoveryRingView
                    android:id="@+id/stepsRingView"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center"
                    android:layout_centerInParent="true">
                    <TextView android:id="@+id/tvStepCount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="8,432" android:textColor="#FFFFFF"
                        android:textSize="32sp" android:fontFamily="sans-serif-bold"
                        android:gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="STEPS" android:textColor="#4CAF50"
                        android:textSize="12sp" android:gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="of 10,000" android:textColor="#888888"
                        android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- Stats row -->
            <LinearLayout android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="#111811" app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_run" app:tint="#4CAF50"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DISTANCE" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginTop="6dp"/>
                        <TextView android:id="@+id/tvStepDistance"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="5.8 km" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="6dp"
                    app:cardBackgroundColor="#111811" app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp" android:gravity="center">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_flame" app:tint="#FF9800"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CALORIES" android:textColor="#888888"
                            android:textSize="10sp" android:layout_marginTop="6dp"/>
                        <TextView android:id="@+id/tvStepCalories"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="320 kcal" android:textColor="#FFFFFF"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>